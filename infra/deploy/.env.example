# Non-secret deployment defaults. Copy to an ignored environment file.
TAPBOT_BACKEND_HOST=0.0.0.0
TAPBOT_BACKEND_PORT=18880
TAPBOT_DRY_RUN=true
TAPBOT_ANDROID_DISCOVERY_ENABLED=true
TAPBOT_ANDROID_DISCOVERY_PROVIDER=tailscale
TAPBOT_ANDROID_AGENT_PORT=8765
TAPBOT_ANDROID_DISCOVERY_INTERVAL_SEC=30
TAPBOT_ANDROID_DISCOVERY_TIMEOUT_SEC=2
TAPBOT_TAP_RANDOMIZATION_ENABLED=true
TAPBOT_TAP_EDGE_INSET_RATIO=0.15
TAPBOT_TAP_SIGMA_RATIO=0.15
TAPBOT_TAP_MAX_JITTER_PX=48
TAPBOT_MACRO_DEFINITION_DIR=/data/macros
TAPBOT_MACRO_BINDINGS_FILE=/data/device-macro-bindings.json

# Configure these through the deployment platform's secret store when used.
TAPBOT_ANDROID_AGENT_URL=
TAPBOT_ANDROID_AGENT_TOKEN=
TAPBOT_MODEL_ENDPOINT=
TAPBOT_MODEL_API_TOKEN=
