{
  "name": "tapbot-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/run-python.cjs scripts/dev.py --mock-android",
    "dev:dry-run": "node scripts/run-python.cjs scripts/dev.py --dry-run --mock-android",
    "dev:mock": "node scripts/run-python.cjs scripts/dev.py --dry-run --mock-android",
    "android:publish": "node scripts/run-python.cjs infra/scripts/publish_android.py",
    "setup": "node scripts/run-python.cjs -m pip install -e . && npm --prefix frontend ci"
  }
}
