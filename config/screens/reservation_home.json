{
  "id": "reservation_home",
  "label": "스터디룸 예약 메인",
  "match": {
    "all": [
      {"content_description": "예약 내역"},
      {"text_regex": "^(월|화|수|목|금|토|일) [0-9]{1,2}$", "min_count": 1}
    ]
  },
  "elements": {
    "reservation_history": {"label": "예약 내역", "selector": {"content_description": "예약 내역", "clickable": true, "visible_to_user": true}, "dedupe": "same_bounds_and_semantics"},
    "quick_date": {"label": "빠른 날짜", "kind": "collection", "selector": {"class_name": "android.widget.Button", "text_regex": "^(월|화|수|목|금|토|일) [0-9]{1,2}$", "clickable": true, "visible_to_user": true}, "order": "left_to_right", "params": ["index"]},
    "date_picker": {"label": "날짜 선택", "selector": {"class_name": "android.widget.Button", "text_regex": "^[0-9]{4}년 [0-9]{1,2}월 [0-9]{1,2}일\\([월화수목금토일]\\)$"}},
    "nav_notice": {"label": "공지 탭", "selector": {"content_description": "공지", "clickable": true}},
    "nav_reservation": {"label": "예약 탭", "selector": {"content_description": "예약", "clickable": true}},
    "nav_my": {"label": "마이 탭", "selector": {"content_description": "마이", "clickable": true}}
  }
}
