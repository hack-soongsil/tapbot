{
  "id": "reservation_detail",
  "label": "스터디룸 예약 상세",
  "match": {
    "all": [
      {"text": "한 칸은 30분입니다. 예약된 시간은 선택할 수 없어요"},
      {"text": "초기화"}
    ]
  },
  "elements": {
    "back": {"label": "뒤로가기", "selector": {"class_name": "android.widget.Button", "bounds_region": "top_left", "clickable": true, "visible_to_user": true}, "fallback_bounds": {"left": 55, "top": 107, "right": 168, "bottom": 223}},
    "date_picker": {"label": "날짜 선택", "selector": {"class_name": "android.widget.Button", "text_regex": "^[0-9]{4}년 [0-9]{1,2}월 [0-9]{1,2}일\\([월화수목금토일]\\)$"}},
    "time_slot": {"label": "30분 시간 슬롯", "kind": "collection", "resolver": "reservation_time_slot", "params": ["index"]},
    "reset_selection": {"label": "선택 초기화", "selector": {"text": "초기화", "class_name": "android.widget.Button"}},
    "reserve_cta": {"label": "예약 CTA", "selector": {"class_name": "android.widget.Button", "text_regex": "^(시간을 선택하세요|이 시간으로 예약하기|예약 처리 중)$"}}
  }
}
