{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tapbot.local/schemas/macro-graph.schema.json",
  "title": "TapBot Macro Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "nodes", "edges"],
  "anyOf": [
    {"required": ["entry_node_id"]},
    {"required": ["screen", "event_entry_node_ids"]},
    {"required": ["screen_event_entry_node_ids"]}
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "entry_node_id": {"type": "string", "minLength": 1},
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "match": {"type": "object"}
      }
    },
    "event_entry_node_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enter", "update", "exit"],
      "properties": {
        "enter": {"type": "string", "minLength": 1},
        "update": {"type": "string", "minLength": 1},
        "exit": {"type": "string", "minLength": 1}
      }
    },
    "screen_event_entry_node_ids": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enter", "update", "exit"],
        "properties": {
          "enter": {"type": "string", "minLength": 1},
          "update": {"type": "string", "minLength": 1},
          "exit": {"type": "string", "minLength": 1}
        }
      }
    },
    "metadata": {"type": "object", "default": {}},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "functions": {
      "type": "array",
      "items": {"$ref": "#/$defs/function"},
      "default": []
    },
    "variables": {
      "type": "array",
      "items": {"$ref": "#/$defs/variable"},
      "default": []
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["bool", "int", "float", "string", "position", "rect", "element"]
        },
        "default": {},
        "input": {"type": "boolean", "default": false},
        "description": {"type": "string"},
        "options": {"type": "array", "items": {}}
      }
    },
    "functionPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["any", "bool", "int", "float", "string", "position", "rect", "element"]
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "inputs", "outputs", "nodes", "edges", "entry_node_id", "return_node_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/functionPort"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/functionPort"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "entry_node_id": {"type": "string", "minLength": 1},
        "return_node_id": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "config"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": [
            "screen_enter", "screen_update", "screen_exit",
            "function_entry", "function_return", "call_function",
            "set_variable", "get_variable",
            "debug_print",
            "click_point", "drag_point", "random_click_area", "random_drag_area",
            "click_element", "find_screen_element", "for_loop", "sequence",
            "tap_element", "tap_point", "swipe", "back", "home", "wait",
            "find_element", "require_element", "read_ui_tree",
            "element_exists", "element_text_equals", "state_equals",
            "branch", "retry", "repeat", "timeout", "stop",
            "wait_for_element", "wait_for_state", "assert_element"
          ]
        },
        "config": {"type": "object"},
        "label": {"type": "string"},
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "source_handle": {"type": "string", "minLength": 1},
        "target_handle": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["exec", "data"]},
        "condition": {
          "type": "string",
          "enum": ["success", "failure", "retry", "stopped"]
        }
      }
    }
  }
}
